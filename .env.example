# ---------- 선택 ----------
# YouTube Data API v3 키 (없으면 참고 영상 대신 유튜브 검색 링크만 표시)
NUXT_YOUTUBE_API_KEY=

# ---------- 관리자 (레시피 등록/수정/삭제) ----------
# 관리자 로그인 비밀번호
NUXT_ADMIN_PASSWORD=
# 로그인 쿠키 암호화 키, 32자 이상 임의 문자열 (예: openssl rand -hex 32)
NUXT_SESSION_SECRET=

# ---------- Supabase (비워 두면 서버의 .data 폴더에 저장) ----------
# Supabase 대시보드 > Project Settings > API 의 Project URL
NUXT_SUPABASE_URL=
# 같은 화면의 secret 키(sb_secret_...) 또는 service_role 키. 절대 공개하지 말 것
NUXT_SUPABASE_SERVICE_ROLE_KEY=
# 레시피 사진을 올릴 Storage 버킷 이름 (supabase/schema.sql 과 같아야 함)
NUXT_SUPABASE_BUCKET=recipe-images
